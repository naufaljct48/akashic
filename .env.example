# ==============================================================================
# Client (Vite) — these are bundled into the browser. Never put a secret here.
# ==============================================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ==============================================================================
# Ingestion scripts / CI only — never exposed to the browser.
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ==============================================================================
# Supabase Edge Function secrets — set with `supabase secrets set`, not here.
#   supabase secrets set AI_API_KEY=... AI_BASE_URL=... AI_MODEL=...
#   supabase secrets set ALLOWED_ORIGINS=https://your-app.vercel.app
#   supabase secrets set MAX_DAILY_PROMPTS=30
# The AI key must stay server-side; there is deliberately no VITE_AI_API_KEY.
# ==============================================================================

# Cloudflare Workers AI (bge-m3 embeddings)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
